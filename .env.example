# Zar Masası ayarları. Kopyala ve düzenle:  cp .env.example .env
# Bu dosya yalnızca kurulumda kullanılır; oyun başladıktan sonra her şey GM ekranından yönetilir.

# Alan adın. Docker kurulumunda Caddy HTTPS sertifikasını bu ad için alır.
ALAN_ADI=oyun.ornek.com

# GM şifresi (zorunlu, en az 8 karakter). GM ekranına (https://alanadin/gm) girerken sorulur.
# GM oyun klasörüne tam erişir: uzun ve tahmin edilemez bir şifre seç, oyun şifresinden farklı olsun.
# Değiştirip sunucuyu yeniden başlatırsan açık GM oturumları kapanır.
# Docker'da sorun çıkmasın diye harf, rakam ve - _ . kullan; $ ve tırnak işareti kullanma.
GM_SIFRESI=

# İlk oyun şifresi (oyuncular girerken sorulur). Sonra GM ekranındaki Ayarlar'dan değiştirilebilir.
# Boş bırakırsan GM ilk açılışta Ayarlar'dan belirler; o zamana kadar oyuncular giremez.
OYUN_SIFRESI=

# Dosya yöneticisiyle yüklenebilecek en büyük dosya (MB)
AZAMI_YUKLEME_MB=64

# Sunucunun dinlediği adres ve port. Önündeki Caddy/nginx HTTPS'i sağlar ve buraya yönlendirir;
# 127.0.0.1 kalsın ki oyuna dışarıdan yalnızca HTTPS üzerinden ulaşılsın.
HOST=127.0.0.1
PORT=3000

# Oyunun bütün dosyaları (haritalar, eşyalar, durum.json) bu klasörde durur.
OYUN_KLASORU=oyun
# Web arayüzü (HTML, CSS, JavaScript)
WEB_KLASORU=web
