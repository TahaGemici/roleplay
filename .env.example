# Roleplay ayarları. kur.sh bu dosyayı sunucuda /var/lib/roleplay/.env olarak oluşturur; orada düzenle.
# Yalnızca açılışta okunur; değiştirince:  sudo systemctl restart systemd-nspawn@roleplay
# Oyun başladıktan sonra her şey GM ekranından yönetilir.

# Alan adın. Açılışta yazılan GM adresi için kullanılır (HTTPS sertifikasını Caddy kendi ayarından alır).
ALAN_ADI=oyun.ornek.com

# GM şifresi (zorunlu, en az 8 karakter). GM ekranına (https://alanadin/gm) girerken sorulur.
# GM oyun klasörüne tam erişir: uzun ve tahmin edilemez bir şifre seç, oyun şifresinden farklı olsun.
# Değiştirip sunucuyu yeniden başlatırsan açık GM oturumları kapanır.
# Şifrede boşluk ya da " #" olacaksa çift tırnak içine yaz: GM_SIFRESI="..."
GM_SIFRESI=

# İlk oyun şifresi (oyuncular girerken sorulur). Sonra GM ekranındaki Ayarlar'dan değiştirilebilir.
# Boş bırakırsan GM ilk açılışta Ayarlar'dan belirler; o zamana kadar oyuncular giremez.
OYUN_SIFRESI=

# Dosya yöneticisiyle yüklenebilecek en büyük dosya (MB)
AZAMI_YUKLEME_MB=64

# Sunucunun dinlediği adres ve port. Konteyner sunucunun ağını paylaşır; Caddy buraya yönlendirir.
# 127.0.0.1 kalsın ki oyuna dışarıdan yalnızca HTTPS üzerinden ulaşılsın.
HOST=127.0.0.1
PORT=3000
